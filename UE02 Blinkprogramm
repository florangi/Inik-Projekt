basic.forever(function () {
    basic.showIcon(IconNames.Heart)
    basic.pause(500)
    basic.clearScreen()
    basic.pause(500)
    basic.showIcon(IconNames.Ghost)
    basic.pause(500)
    basic.clearScreen()
    basic.pause(500)
})

